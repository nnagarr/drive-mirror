{
  "name": "drive-mirror",
  "version": "1.0.0",
  "description": "Mirror local folders up to Google Drive",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nnagarr/drive-mirror.git"
  },
  "author": {
    "name": "nnagarr"
  },
  "homepage": "https://github.com/nnagarr/drive-mirror#readme"
}
